{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],

  "baseBranchPatterns": ["main"],

  // Do not rebase when the default branch is updated
  "rebaseWhen": "never",

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      // pinDigest only records the digest of an already-referenced version —
      // no new upstream code. Plain 'digest' updates DO pull new code, so they
      // require human review even when CI passes (supply-chain gate, #474).
      "automerge": true,
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"]
    },
    // reusable-validate-renovate.yml installs the renovate CLI, whose
    // engines.node is pinned to a single major (currently ^24). Hold Node
    // there until renovate itself supports the next major.
    {
      "matchFileNames": [".github/workflows/reusable-validate-renovate.yml"],
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    // First-party self-references must stay on the floating @v1 tag, which this
    // repo's release process advances deliberately. config:best-practices pulls in
    // helpers:pinGitHubActionDigests, which would otherwise pin and then bump
    // projectbluefin/actions -> itself. SHA pinning is a defence against tag
    // hijacking on repos we do not control; it does not apply to our own code.
    // Keep this rule last so it wins over the automerge rules above.
    // Other projectbluefin repos (e.g. testsuite) are cross-repo and stay pinned.
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["projectbluefin/actions"],
      "enabled": false
    }
  ]
}
